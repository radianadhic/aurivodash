{
  "version": 2,
  "width": 700,
  "page": {
    "paper": "A4",
    "orientation": "portrait",
    "margins": { "top": 47, "right": 47, "bottom": 47, "left": 47 },
    "pagination": true
  },
  "pageHeaderSection": { "height": 34, "visible": false, "style": {}, "items": [] },
  "headerSection": {
    "height": 86,
    "visible": true,
    "style": { "backgroundColor": "#0f172a" },
    "items": [
      { "id": "h1", "type": "text", "text": "Nama Perusahaan", "binding": "company", "x": 16, "y": 12, "width": 420, "height": 26, "style": { "color": "#ffffff", "fontSize": 18, "fontWeight": "bold" } },
      { "id": "h2", "type": "text", "text": "Judul Laporan", "binding": "title", "x": 16, "y": 42, "width": 420, "height": 18, "style": { "color": "#94a3b8", "fontSize": 12 } },
      { "id": "h3", "type": "text", "text": "Dicetak: {Now}", "binding": "", "x": 460, "y": 14, "width": 224, "height": 16, "style": { "color": "#cbd5e1", "fontSize": 10, "textAlign": "right" } },
      { "id": "h4", "type": "barcode", "text": "No. Dokumen", "binding": "docNo", "x": 560, "y": 36, "width": 124, "height": 38, "style": { "color": "#ffffff" } }
    ]
  },
  "contentSection": {
    "height": 34,
    "binding": "content",
    "visible": true,
    "style": {},
    "groups": [],
    "items": [
      { "id": "c1", "type": "text", "text": "Nama", "binding": "name", "x": 10, "y": 8, "width": 130, "height": 18, "style": { "fontSize": 11 } },
      { "id": "c2", "type": "text", "text": "Kota", "binding": "city", "x": 145, "y": 8, "width": 90, "height": 18, "style": { "fontSize": 11 } },
      { "id": "c3", "type": "text", "text": "Produk", "binding": "product", "x": 240, "y": 8, "width": 160, "height": 18, "style": { "fontSize": 11 } },
      { "id": "c4", "type": "text", "text": "Qty", "binding": "qty", "x": 405, "y": 8, "width": 50, "height": 18, "style": { "fontSize": 11, "textAlign": "right" } },
      { "id": "c5", "type": "text", "text": "Harga", "binding": "price", "x": 460, "y": 8, "width": 100, "height": 18, "style": { "fontSize": 11, "textAlign": "right" } },
      { "id": "c6", "type": "text", "text": "Total", "binding": "total", "x": 565, "y": 8, "width": 125, "height": 18, "style": { "fontSize": 11, "textAlign": "right", "fontWeight": "bold" } }
    ]
  },
  "footerSection": {
    "height": 64,
    "visible": true,
    "style": { "backgroundColor": "#f1f5f9" },
    "items": [
      { "id": "f1", "type": "text", "text": "Jumlah baris: {Count} — Total penjualan: {Sum(total)}", "binding": "", "x": 12, "y": 10, "width": 460, "height": 16, "style": { "fontSize": 11, "fontWeight": "bold", "color": "#0f172a" } },
      { "id": "f2", "type": "text", "text": "Catatan 1", "binding": "footer1", "x": 12, "y": 30, "width": 400, "height": 14, "style": { "fontSize": 10, "color": "#64748b" } },
      { "id": "f3", "type": "text", "text": "Catatan 2", "binding": "footer2", "x": 12, "y": 46, "width": 400, "height": 14, "style": { "fontSize": 10, "color": "#64748b" } }
    ]
  },
  "pageFooterSection": {
    "height": 30,
    "visible": true,
    "style": {},
    "items": [
      { "id": "p1", "type": "text", "text": "Halaman {PageNo} dari {PageCount}", "binding": "", "x": 200, "y": 8, "width": 300, "height": 14, "style": { "fontSize": 9, "color": "#94a3b8", "textAlign": "center" } }
    ]
  }
}
